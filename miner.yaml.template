    external_path: /v1/intent
    method: POST
    description: Check a factual claim against published fact-check evidence. The request body uses intent and an input object containing claim.
    intents:
      - FACT_CHECK
    content_type: application/json
    params:
      body:
        required:
          - name: intent
            type: string
            intents:
              - FACT_CHECK
            description: Canonical Intent name; must be FACT_CHECK.
            accepted_fields:
              - value: FACT_CHECK
                intents:
                  - FACT_CHECK
                description: Select the FACT_CHECK capability.
          - name: input
            type: object
            intents:
              - FACT_CHECK
            description: Intent-specific input object. Required field: claim.
