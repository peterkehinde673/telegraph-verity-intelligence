    intents:
      - FACT_CHECK
    content_type: application/json
    params:
      body:
        required:
          - name: intent
            type: string
            intents:
              - FACT_CHECK
            description: Canonical Intent name; must be FACT_CHECK.
          - name: input
            type: object
            intents:
              - FACT_CHECK
            description: Intent-specific input object. Required field: claim.
