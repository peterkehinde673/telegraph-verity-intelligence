version: "1"
kind: miner
# Replace this placeholder only after verifying an unused Miner ID against Telegraph's live registry.
id: "5530"
slug: telegraph-verity-intelligence
name: Telegraph Verity Intelligence
description: Evidence-grounded intelligence provider for research, content verification, media authenticity, and cybersecurity analysis.
base_url: https://telegraph-verity-intelligence-api.onrender.com

